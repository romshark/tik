package main

// The example call is split into Go strings because templ collapses
// whitespace in text, even inside <pre>.
const (
	exampleCallStart = "reader.String(\n\t`"
	exampleTIK       = "You have {# unread messages}."
	exampleCallEnd   = "`,\n\tunreadCount,\n)"
)

templ landingPage(specVersion string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>TIK - Textual Internationalization Key</title>
			<meta name="description" content="A TIK is a translation key you write directly in your source code, as the message text itself."/>
			<link rel="stylesheet" href="theme.css"/>
			<script src="theme.js"></script>
			<style>
			body {
				margin: 0;
				padding: 4rem 1rem;
				font-family: sans-serif;
				line-height: 1.6;
				background-color: var(--background);
				color: var(--foreground);
			}

			main {
				max-width: 40rem;
				margin: auto;
			}

			h1 {
				margin: 0;
				font-size: 2.5rem;
			}

			.subtitle {
				margin-top: 0;
				color: var(--muted);
			}

			pre {
				padding: .8rem 1rem;
				border-radius: .5rem;
				overflow-x: auto;
				tab-size: 4;
				background-color: var(--code-background);
				color: var(--muted);
			}

			pre strong {
				color: var(--foreground);
			}

			nav {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 1.5rem;
				margin-top: 2rem;
			}

			a {
				color: var(--primary);
			}

			a.github {
				display: inline-flex;
				align-items: center;
				gap: .4rem;
			}

			a.github svg {
				width: 1.2em;
				height: 1.2em;
			}

			a.button {
				padding: .6rem 1.2rem;
				border-radius: .5rem;
				background-color: var(--primary);
				color: var(--primary-foreground);
				font-weight: bold;
				text-decoration: none;
			}

			/* Phones, including landscape: no extra space above the title. */
			@media (max-width: 30rem), (max-height: 30rem) {
				body {
					padding: 1rem;
				}
			}

			/* Narrow phones: fit the example and give the button its own row. */
			@media (max-width: 30rem) {
				pre {
					padding: .8rem .6rem;
					tab-size: 2;
				}

				nav {
					justify-content: center;
					gap: 1rem 1.5rem;
				}

				a.button {
					box-sizing: border-box;
					flex-basis: 100%;
					text-align: center;
				}
			}
		</style>
		</head>
		<body>
			<main>
				<h1>TIK</h1>
				<p class="subtitle">Textual Internationalization Key</p>
				<p>
					A TIK is a translation key you write directly in your source code,
					as the message text itself:
				</p>
				<pre><code>{ exampleCallStart }<strong>{ exampleTIK }</strong>{ exampleCallEnd }</code></pre>
				<p>
					TIK processors extract TIKs from the code and turn them into ICU messages for translation.
				</p>
				<nav>
					<a class="button" href="cheatsheet/">Cheatsheet</a>
					<a href={ "https://github.com/romshark/tik/blob/" + specVersion + "/SPECIFICATION.md" }>Specification { specVersion }</a>
					<a class="github" href="https://github.com/romshark/tik">
						<svg viewBox="0 0 16 16" aria-hidden="true">
							<path fill="currentColor" d="M6.766 11.328c-2.063-.25-3.516-1.734-3.516-3.656 0-.781.281-1.625.75-2.188-.203-.515-.172-1.609.063-2.062.625-.078 1.468.25 1.968.703.594-.187 1.219-.281 1.985-.281.765 0 1.39.094 1.953.265.484-.437 1.344-.765 1.969-.687.218.422.25 1.515.046 2.047.5.593.766 1.39.766 2.203 0 1.922-1.453 3.375-3.547 3.64.531.344.89 1.094.89 1.954v1.625c0 .468.391.734.86.547C13.781 14.359 16 11.53 16 8.03 16 3.61 12.406 0 7.984 0 3.563 0 0 3.61 0 8.031a7.88 7.88 0 0 0 5.172 7.422c.422.156.828-.125.828-.547v-1.25c-.219.094-.5.156-.75.156-1.031 0-1.64-.562-2.078-1.609-.172-.422-.36-.672-.719-.719-.187-.015-.25-.093-.25-.187 0-.188.313-.328.625-.328.453 0 .844.281 1.25.86.313.452.64.655 1.031.655s.641-.14 1-.5c.266-.265.47-.5.657-.656"></path>
						</svg>
						GitHub
					</a>
				</nav>
			</main>
		</body>
	</html>
}
