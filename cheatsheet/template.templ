package main

type Section struct {
	ID, Header, Description string
	ExampleTIK, ICU         string
	Examples                []Example
}

type Example struct {
	Data string
	Text string
}

templ templatePage(title string, sections []Section) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<title>{ title }</title>
			<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
			<meta name="description" content="A textual internationalization key (TIK) cheatsheet."/>
			<meta name="keywords" content="i18n, TIK, cheatsheet"/>
			<meta name="author" content="Roman Scharkov (roman.scharkov@gmail.com)"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<link rel="stylesheet" href="../theme.css"/>
			<script src="../theme.js"></script>
			<style>
			body {
				font-family: sans-serif;
				max-width: 900px;
				margin: auto;
				margin-top: 1rem;
				margin-bottom: 3rem;
				padding: 1rem;
				box-sizing: border-box;
				background-color: var(--background);
				color: var(--foreground);
			}

			footer {
				margin-top: 2rem;
			}

			a {
				color: var(--primary);
			}

			h1 {
				font-size: 1.5rem;
			}

			code {
				background-color: var(--code-background);
				border-radius: .3rem;
				padding: .3rem;
				line-height: 2rem;
				white-space: pre;
			}

			section {
				border: 1px solid var(--border);
				border-radius: 1rem;
				margin-top: 1rem;
				margin-bottom: .5rem;
				overflow: hidden;
				background-color: var(--surface);
			}

			section h2 {
				margin: 0;
				font-size: large;
			}

			section p {
				margin: 0;
			}

			.section-header {
				border-bottom: 1px solid var(--border);
				padding: .5rem;
				display: flex;
				flex-direction: row;
				gap: 1rem;
				align-items: center;
			}

			.section-body {
				padding: .5rem;
				overflow: auto;
			}

			.section-header p {
				color: var(--muted);
			}

			ul li {
				margin: 0;
			}

			ul.examples {
				margin: 0;
				padding: 0;
				list-style: none;
			}

			.example {
				display: flex;
				align-items: center;
				gap: .5rem;
			}

			.arrow {
				font-size: 1.1rem;
				line-height: 1;
			}

			.labeled {
				display: inline-flex;
				padding-bottom: .3rem;
				padding-top: .3rem;
				font-size: 0;
				font-family: monospace;
				vertical-align: baseline;
				align-items: stretch;
			}

			.labeled label {
				display: block;
				font-size: small;
				font-weight: bold;
				padding: .3rem;
				padding-left: .5rem;
				padding-right: .5rem;
				border-top-left-radius: .5rem;
				border-bottom-left-radius: .5rem;
				margin: 0;
			}

			.labeled span {
				display: block;
				font-size: small;
				background-color: var(--code-background);
				padding: .3rem;
				padding-left: .5rem;
				padding-right: .5rem;
				margin: 0;
				border-top-right-radius: .5rem;
				border-bottom-right-radius: .5rem;
			}

			.labeled.data label {
				background-color: var(--primary);
				color: var(--primary-foreground);
			}

			.labeled.text label {
				background-color: var(--secondary);
				color: var(--primary-foreground);
			}

			/* Below the width that fits the widest example on one line,
			   stack each data and text pair vertically. */
			@media (max-width: 50rem) {
				ul.examples {
					display: flex;
					flex-direction: column;
					gap: 1rem;
					margin-top: .5rem;
				}

				.example {
					flex-direction: column;
					align-items: flex-start;
					gap: .25rem;
				}

				.labeled {
					padding-top: 0;
					padding-bottom: 0;
				}

				.arrow {
					display: none;
				}
			}
		</style>
		</head>
		<body>
			<h1>{ title }</h1>
			This cheatsheet will help you write
			<a href="../">
				textual internationalization keys (TIKs)
			</a>.
			for _, section := range sections {
				@templateSection(section)
			}
			<footer>
				Also see <a target="_blank" href="https://unicode-org.github.io/icu/userguide/format_parse/messages/">ICU Message Format</a>
			</footer>
		</body>
	</html>
}

templ templateSection(section Section) {
	<section aria-labelledby={ section.ID }>
		<div class="section-header">
			<h2 id={ section.ID }>
				<code>
					@templ.Raw(section.Header)
				</code>
			</h2>
			<p>
				@templ.Raw(section.Description)
			</p>
		</div>
		<div class="section-body">
			<table>
				<tr>
					<td>Example</td>
					<td><code>{ section.ExampleTIK }</code></td>
				</tr>
				<tr>
					<td>ICU</td>
					<td><code>{ section.ICU }</code></td>
				</tr>
			</table>
			<ul class="examples">
				for _, example := range section.Examples {
					<li>
						<div class="example">
							<div class="labeled data">
								<label>data</label>
								<span>{ example.Data }</span>
							</div>
							<div class="arrow">→</div>
							<div class="labeled text">
								<label>text</label>
								<span>{ example.Text }</span>
							</div>
						</div>
					</li>
				}
			</ul>
		</div>
	</section>
}
